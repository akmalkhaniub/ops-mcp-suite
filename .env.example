# Environment Variables for Ops MCP Suite

# GitHub MCP integration token
GITHUB_TOKEN=your_github_token_here

# Secrets MCP Vault Master Key
# Leave blank to auto-generate a vault.key file instead
VAULT_MASTER_KEY=

# AWS Credentials (if not using IAM roles/profiles)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1

# Optional: LangSmith API Key for agent tracing
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ops-mcp-suite
